<Window
    x:Class="OMSICompatible.Launcher.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OMSI Compatible Runtime x64">

    <Grid x:Name="RootGrid" Background="#0A0D12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="#0D1118"
            Padding="18,0">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">
                <Border
                    Width="25"
                    Height="25"
                    CornerRadius="7"
                    Background="#178BDB">
                    <FontIcon
                        Glyph="&#xE7FC;"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
                <TextBlock
                    Text="OMSI Compatible Runtime"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
                <Border
                    Background="#1C2A39"
                    CornerRadius="8"
                    Padding="8,3">
                    <TextBlock
                        Text="x64 · D3D11"
                        Foreground="#87C8F4"
                        FontSize="11"
                        FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1280"
                HorizontalAlignment="Center"
                Padding="28,24,28,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    CornerRadius="20"
                    Background="#151B24"
                    BorderBrush="#273240"
                    BorderThickness="1">
                    <Grid>
                        <Image
                            x:Name="HeroImage"
                            Stretch="UniformToFill"
                            Opacity="0.78"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F30A0D12" Offset="0"/>
                                    <GradientStop Color="#BC0A0D12" Offset="0.50"/>
                                    <GradientStop Color="#400A0D12" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel
                            VerticalAlignment="Bottom"
                            Margin="34,0,34,30"
                            Spacing="8">
                            <TextBlock
                                Text="RUNTIME COMPATÍVEL · 64 BITS"
                                Foreground="#70C7FF"
                                FontSize="12"
                                FontWeight="SemiBold"
                                CharacterSpacing="70"/>
                            <TextBlock
                                x:Name="HeroTitle"
                                Text="Escolha um mapa"
                                Foreground="White"
                                FontSize="34"
                                FontWeight="SemiBold"
                                MaxWidth="820"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                x:Name="HeroSubtitle"
                                Text="Carregamento por tiles · ônibus OMSI · Direct3D 11"
                                Foreground="#C2CDDA"
                                FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="ContentPathBox"
                        Grid.Column="0"
                        Header="Pasta do conteúdo OMSI"
                        PlaceholderText="G:\Games\OMSI 2 Steam Edition"
                        MinWidth="520"/>

                    <Button
                        Grid.Column="1"
                        Content="Procurar"
                        Margin="0,26,0,0"
                        Padding="20,8"
                        Click="BrowseButton_Click"/>

                    <Button
                        Grid.Column="2"
                        Content="Atualizar"
                        Margin="0,26,0,0"
                        Padding="20,8"
                        Click="RefreshButton_Click"/>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#151B24"
                        BorderBrush="#253140"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="MAPA"
                                Foreground="#8192A8"
                                FontSize="11"
                                FontWeight="SemiBold"/>
                            <ComboBox
                                x:Name="MapBox"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="FolderName"
                                PlaceholderText="Selecione o mapa"
                                SelectionChanged="MapBox_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="#151B24"
                        BorderBrush="#253140"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="PONTO INICIAL"
                                Foreground="#8192A8"
                                FontSize="11"
                                FontWeight="SemiBold"/>
                            <ComboBox
                                x:Name="SpawnBox"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Name"
                                PlaceholderText="Selecione o spawn"
                                SelectionChanged="SelectionChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    Background="#151B24"
                    BorderBrush="#253140"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="SELEÇÃO DO ÔNIBUS"
                                    Foreground="#8192A8"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>
                                <CheckBox
                                    x:Name="NoBusCheckBox"
                                    Grid.Column="1"
                                    Content="Iniciar sem ônibus"
                                    Foreground="#D8E1EC"
                                    Checked="NoBusModeChanged"
                                    Unchecked="NoBusModeChanged"/>
                            </Grid>

                            <ComboBox
                                x:Name="CarroceriaBox"
                                Header="Carroceria"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Selecione a carroceria"
                                SelectionChanged="CarroceriaBox_SelectionChanged"/>

                            <ComboBox
                                x:Name="ModeloBox"
                                Header="Modelo"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Selecione o modelo"
                                SelectionChanged="ModeloBox_SelectionChanged"/>

                            <ComboBox
                                x:Name="SkinBox"
                                Header="Skin"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Skin"
                                PlaceholderText="Selecione a skin"
                                SelectionChanged="SkinBox_SelectionChanged"/>
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            MinHeight="230"
                            Background="#0E141C"
                            BorderBrush="#24303E"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid>
                                <Image
                                    x:Name="BusPreviewImage"
                                    Stretch="UniformToFill"
                                    Opacity="0.92"/>
                                <TextBlock
                                    x:Name="BusPreviewEmptyText"
                                    Text="Sem imagem de prévia"
                                    Foreground="#7F8FA3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#10000000" Offset="0"/>
                                            <GradientStop Color="#E0000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel
                                    VerticalAlignment="Bottom"
                                    Margin="18"
                                    Spacing="3">
                                    <TextBlock
                                        x:Name="BusPreviewTitle"
                                        Text="Nenhum ônibus selecionado"
                                        Foreground="White"
                                        FontSize="19"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        x:Name="BusPreviewSubtitle"
                                        Text="Escolha carroceria e modelo"
                                        Foreground="#C4CFDB"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        x:Name="BusPreviewSkin"
                                        Text=""
                                        Foreground="#70C7FF"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="4"
                    Margin="0,18,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#111720"
                        CornerRadius="14"
                        Padding="16,13">
                        <StackPanel>
                            <TextBlock Text="MAPAS" Foreground="#78899D" FontSize="10"/>
                            <TextBlock x:Name="MapCountText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="#111720"
                        CornerRadius="14"
                        Padding="16,13">
                        <StackPanel>
                            <TextBlock Text="ÔNIBUS" Foreground="#78899D" FontSize="10"/>
                            <TextBlock x:Name="BusCountText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="#111720"
                        CornerRadius="14"
                        Padding="16,13">
                        <StackPanel>
                            <TextBlock Text="STREAMING" Foreground="#78899D" FontSize="10"/>
                            <TextBlock Text="3×3 · 9 tiles ativos" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="PlayButton"
                        Grid.Column="3"
                        Content="▶  JOGAR"
                        IsEnabled="False"
                        FontSize="16"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="PlayButton_Click"/>
                </Grid>

                <Expander
                    Grid.Row="5"
                    Header="Diagnóstico"
                    Margin="0,18,0,0"
                    IsExpanded="False">
                    <TextBox
                        x:Name="LogBox"
                        Height="150"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono"/>
                </Expander>
            </Grid>
        </ScrollViewer>

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="2"
            Background="#F20A0D12"
            Visibility="Collapsed">
            <Grid
                MaxWidth="1100"
                Margin="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Height="440"
                    CornerRadius="24"
                    Background="#141B24"
                    BorderBrush="#263445"
                    BorderThickness="1">
                    <Grid>
                        <Image
                            x:Name="LoadingImage"
                            Stretch="UniformToFill"
                            Opacity="0.82"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22000000" Offset="0"/>
                                    <GradientStop Color="#E0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel
                            VerticalAlignment="Bottom"
                            Margin="28"
                            Spacing="6">
                            <TextBlock
                                Text="OMSI COMPATIBLE RUNTIME"
                                Foreground="#70C7FF"
                                FontSize="11"
                                FontWeight="SemiBold"/>
                            <TextBlock
                                x:Name="LoadingMapText"
                                Text="Mapa"
                                Foreground="White"
                                FontSize="28"
                                FontWeight="SemiBold"/>
                            <TextBlock
                                x:Name="LoadingBusText"
                                Text="Ônibus"
                                Foreground="#D0D9E4"
                                FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="36,20,0,20"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <ProgressRing
                        Width="38"
                        Height="38"
                        IsActive="True"
                        HorizontalAlignment="Left"/>
                    <TextBlock
                        x:Name="LoadingStageText"
                        Text="Preparando..."
                        Foreground="White"
                        FontSize="24"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        x:Name="LoadingDetailText"
                        Text="Inicializando runtime x64..."
                        Foreground="#AAB8C9"
                        FontSize="14"
                        TextWrapping="Wrap"
                        MaxWidth="380"/>
                    <ProgressBar
                        x:Name="LoadingProgress"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="6"
                        Margin="0,8,0,0"/>
                    <TextBlock
                        x:Name="LoadingPercentText"
                        Text="0%"
                        Foreground="#DCE8F5"
                        FontSize="13"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="Os tiles são carregados por área. O mapa completo não fica residente na RAM/VRAM."
                        Foreground="#6F8298"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
