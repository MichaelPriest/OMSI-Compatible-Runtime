<Window
    x:Class="OMSICompatible.Launcher.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OMSI Compatible Runtime">

    <Grid x:Name="RootGrid" Background="#08111C">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="#0B1725"
              Padding="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Border Width="30"
                        Height="30"
                        Background="#F58B22">
                    <TextBlock Text="O"
                               Foreground="#08111C"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="OMSI Compatible Runtime"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Runtime x64 · Alpha"
                       Foreground="#8297AC"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#091522">
                <Grid Padding="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <Button x:Name="HomeNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="HomeNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;"/>
                                <TextBlock Text="Início" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlayNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="NewSessionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;"/>
                                <TextBlock Text="Jogar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MapsNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="MapsNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE707;"/>
                                <TextBlock Text="Mapas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="VehiclesNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="VehiclesNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE804;"/>
                                <TextBlock Text="Veículos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="46"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;"/>
                                <TextBlock Text="Add-ons" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CompatibilityNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="CompatibilityNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EF;"/>
                                <TextBlock Text="Compatibilidade" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ControlsNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="ControlsNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F8;"/>
                                <TextBlock Text="Controles" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="SettingsNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;"/>
                                <TextBlock Text="Configurações" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DiagnosticsNavButton"
                                Height="46"
                                HorizontalContentAlignment="Left"
                                Click="DiagnosticsNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D9;"/>
                                <TextBlock Text="Diagnóstico" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="3">
                        <TextBlock Text="Versão Alpha"
                                   Foreground="#AFC0D2"
                                   FontSize="12"/>
                        <TextBlock Text="WinUI 3 · D3D11 · ODE x64"
                                   Foreground="#718398"
                                   FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="HomeView"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28"
                            Spacing="16">
                    <Border Background="#111E2D"
                            Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="HeroTitle"
                                           Text="OMSI Compatible Runtime"
                                           Foreground="White"
                                           FontSize="40"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="HeroSubtitle"
                                           Text="Runtime x64 compatível com conteúdo OMSI"
                                           Foreground="#B8C7D7"
                                           FontSize="15"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="ContinueButton"
                                            Content="Continuar"
                                            Click="ContinueButton_Click"/>
                                    <Button Content="Nova sessão"
                                            Click="NewSessionButton_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#0A1420"
                                    Height="190">
                                <Image x:Name="HeroImage"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="#111E2D" Padding="12">
                            <StackPanel><TextBlock Text="Runtime x64" Foreground="#8FA2B7"/><TextBlock x:Name="RuntimeStatusText" Text="Verificando" Foreground="White"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="3,0" Background="#111E2D" Padding="12">
                            <StackPanel><TextBlock Text="ODE" Foreground="#8FA2B7"/><TextBlock x:Name="OdeStatusText" Text="Verificando" Foreground="White"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="3,0" Background="#111E2D" Padding="12">
                            <StackPanel><TextBlock Text="D3D11" Foreground="#8FA2B7"/><TextBlock x:Name="D3D11StatusText" Text="Verificando" Foreground="White"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="3,0" Background="#111E2D" Padding="12">
                            <StackPanel><TextBlock Text="Conteúdo" Foreground="#8FA2B7"/><TextBlock x:Name="CompatibilityStatusText" Text="Aguardando" Foreground="White"/></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Margin="6,0,0,0" Background="#111E2D" Padding="12">
                            <StackPanel><TextBlock Text="Canal" Foreground="#8FA2B7"/><TextBlock x:Name="UpdateStatusText" Text="Alpha" Foreground="White"/></StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="#111E2D"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="LastSessionImage"
                                       Height="140"
                                       Stretch="UniformToFill"/>
                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Spacing="7">
                                    <TextBlock Text="Última sessão"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LastSessionDateText" Text="Nenhuma sessão" Foreground="#8FA2B7"/>
                                    <TextBlock x:Name="LastMapText" Text="—" Foreground="White"/>
                                    <TextBlock x:Name="LastBusText" Text="—" Foreground="#C9D5E1"/>
                                    <TextBlock x:Name="LastSpawnText" Text="—" Foreground="#9EAFBF"/>
                                    <TextBlock x:Name="LastTimeText" Text="—" Foreground="#9EAFBF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Background="#111E2D"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Biblioteca"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Mapas" Foreground="#8FA2B7"/>
                                <TextBlock x:Name="MapCountText" Text="0" Foreground="White" FontSize="24"/>
                                <TextBlock Text="Veículos" Foreground="#8FA2B7"/>
                                <TextBlock x:Name="BusCountText" Text="0" Foreground="White" FontSize="24"/>
                                <TextBlock Text="Objetos" Foreground="#8FA2B7"/>
                                <TextBlock x:Name="ObjectCountText" Text="0" Foreground="White" FontSize="24"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="SessionView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28"
                                Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE768;"
                                      FontSize="28"
                                      Foreground="#8DB7FF"/>
                            <TextBlock Text="Nova sessão"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="ContentPathBox"
                                 Header="Biblioteca OMSI"
                                 PlaceholderText="Pasta raiz do OMSI"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button Click="BrowseButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE838;"/>
                                    <TextBlock Text="Procurar pasta"/>
                                </StackPanel>
                            </Button>
                            <Button Click="RefreshButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;"/>
                                    <TextBlock Text="Atualizar conteúdo"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="ContentDiscoveryProgress"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                <ProgressRing Width="18"
                                              Height="18"
                                              IsActive="True"/>
                                <TextBlock Text="Carregando biblioteca..."
                                           Foreground="#8FA2B7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <ComboBox x:Name="MapBox"
                                  Header="Mapa"
                                  DisplayMemberPath="FolderName"
                                  SelectionChanged="MapBox_SelectionChanged"/>
                        <ComboBox x:Name="SpawnBox"
                                  Header="Ponto inicial"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SelectionChanged"/>
                        <CheckBox x:Name="NoBusCheckBox"
                                  Content="Iniciar sem ônibus"
                                  Checked="NoBusModeChanged"
                                  Unchecked="NoBusModeChanged"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CarroceriaBox"
                                      Grid.Column="0"
                                      Margin="0,0,6,0"
                                      Header="Carroceria"
                                      SelectionChanged="CarroceriaBox_SelectionChanged"/>
                            <ComboBox x:Name="ModeloBox"
                                      Grid.Column="1"
                                      Margin="3,0"
                                      Header="Modelo"
                                      SelectionChanged="ModeloBox_SelectionChanged"/>
                            <ComboBox x:Name="SkinBox"
                                      Grid.Column="2"
                                      Margin="3,0"
                                      Header="Skin / repaint"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="SkinBox_SelectionChanged"/>
                            <ComboBox x:Name="HofBox"
                                      Grid.Column="3"
                                      Margin="6,0,0,0"
                                      Header="HOF"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="HofBox_SelectionChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#111E2D"
                                    Height="190"
                                    CornerRadius="10">
                                <Grid>
                                    <Image x:Name="BusPreviewImage"
                                           Stretch="Uniform"/>
                                    <StackPanel x:Name="BusPreviewEmptyPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                                  Glyph="&#xE804;"
                                                  FontSize="42"
                                                  Foreground="#71869B"/>
                                        <TextBlock x:Name="BusPreviewEmptyText"
                                                   Text="Sem imagem de prévia"
                                                   Foreground="#71869B"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Spacing="8">
                                <TextBlock x:Name="BusPreviewTitle"
                                           Text="Nenhum ônibus selecionado"
                                           Foreground="White"
                                           FontSize="22"/>
                                <TextBlock x:Name="BusPreviewSubtitle" Text="" Foreground="#AFC0D2"/>
                                <TextBlock x:Name="BusPreviewSkin" Text="" Foreground="#879AAD"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="Preview3DButton"
                                            Height="50"
                                            Click="Preview3DButton_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10"
                                                    HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                                      Glyph="&#xE7C5;"/>
                                            <TextBlock Text="PRÉVIA 3D"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PlayButton"
                                            Height="50"
                                            Click="PlayButton_Click">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10"
                                                    HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                                      Glyph="&#xE768;"/>
                                            <TextBlock Text="INICIAR SIMULAÇÃO"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="MapsView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE707;"
                                  FontSize="28"
                                  Foreground="#8DB7FF"/>
                        <TextBlock Text="Mapas"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MapsSearchBox"
                                 PlaceholderText="Pesquisar mapas"
                                 TextChanged="MapsSearchBox_TextChanged"/>
                        <TextBlock x:Name="MapsResultCountText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Text="0 mapas"
                                   Foreground="#8FA2B7"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <GridView x:Name="MapsGrid"
                              Grid.Row="2"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="MapLibraryItem_Click"/>
                </Grid>
            </Grid>

            <Grid x:Name="VehiclesView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE806;"
                                  FontSize="28"
                                  Foreground="#8DB7FF"/>
                        <TextBlock Text="Veículos"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VehiclesSearchBox"
                                 PlaceholderText="Pesquisar veículos"
                                 TextChanged="VehiclesSearchBox_TextChanged"/>
                        <TextBlock x:Name="VehiclesResultCountText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Text="0 veículos"
                                   Foreground="#8FA2B7"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <GridView x:Name="VehiclesGrid"
                              Grid.Row="2"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="VehicleLibraryItem_Click"/>
                </Grid>
            </Grid>

            <Grid x:Name="ControlsView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE7F8;"
                                      FontSize="28"
                                      Foreground="#8DB7FF"/>
                            <TextBlock Text="Controles" Foreground="White" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ControlsSubtitleText" Text="Arquivos reais de entrada OMSI" Foreground="#8FA2B7"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,12"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Button Content="Atualizar" Click="RefreshControlsButton_Click"/>
                        <TextBlock x:Name="ControlsBindingCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="ControlsKeyCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="ControlsControllerCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="ControlsControllerStateText" Text="OFF" Foreground="White"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="ControlsKeyboardList"
                                  SelectionMode="None"/>
                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Spacing="8">
                            <TextBlock x:Name="ControlsKeyboardPathText" Text="keyboard.cfg" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                            <TextBlock x:Name="ControlsControllerPathText" Text="gamectrler.cfg" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                            <TextBlock x:Name="ControlsKeyboardCountText" Text="0" Foreground="#AFC0D2"/>
                            <TextBlock x:Name="ControlsKeyTableCountText" Text="0" Foreground="#AFC0D2"/>
                            <TextBlock x:Name="ControlsKeyTableFileText" Text="" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                            <TextBlock x:Name="ControlsGameControllerStateText" Text="" Foreground="#AFC0D2"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28"
                                Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE713;"
                                      FontSize="28"
                                      Foreground="#8DB7FF"/>
                            <TextBlock Text="Configurações"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Importar options.cfg" Click="ImportOmsiOptionsButton_Click"/>
                            <Button Content="Salvar" Click="SaveRuntimeOptionsButton_Click"/>
                        </StackPanel>

                        <TextBox x:Name="SettingsLanguageBox" Header="Idioma"/>
                        <TextBox x:Name="SettingsTargetFpsBox" Header="FPS alvo"/>
                        <TextBox x:Name="SettingsNeighborTilesBox" Header="Tiles vizinhos"/>
                        <CheckBox x:Name="SettingsAutoSaveCheck" Content="Auto Save"/>
                        <CheckBox x:Name="SettingsCurrentTimeCheck" Content="Usar hora atual"/>
                        <CheckBox x:Name="SettingsCurrentDateCheck" Content="Usar data atual"/>
                        <TextBox x:Name="SettingsObjectDistanceBox" Header="Distância de objetos (m)"/>
                        <TextBox x:Name="SettingsTextureMemoryBox" Header="Memória de textura (MB)"/>
                        <TextBox x:Name="SettingsAnisotropicBox" Header="Filtro anisotrópico"/>
                        <CheckBox x:Name="SettingsShadowsCheck" Content="Sombras"/>
                        <CheckBox x:Name="SettingsNightMapCheck" Content="Night maps"/>
                        <CheckBox x:Name="SettingsLightMapCheck" Content="Light maps"/>
                        <TextBox x:Name="SettingsMasterVolumeBox" Header="Volume mestre (%)"/>
                        <TextBox x:Name="SettingsRoadTrafficBox" Header="Tráfego rodoviário (%)"/>
                        <TextBox x:Name="SettingsPassengerFactorBox" Header="Passageiros (%)"/>
                        <CheckBox x:Name="SettingsAiSoundsCheck" Content="Som dos veículos IA"/>
                        <CheckBox x:Name="SettingsScenerySoundsCheck" Content="Sons de cenário"/>
                        <CheckBox x:Name="SettingsGameControllerCheck" Content="Game Controller"/>
                        <TextBox x:Name="SettingsStreamingRadiusBox" Header="Raio de streaming"/>
                        <CheckBox x:Name="SettingsVsyncCheck" Content="VSync"/>
                        <CheckBox x:Name="SettingsBorderlessCheck" Content="Fullscreen borderless"/>
                        <CheckBox x:Name="SettingsHardwareGpuCheck" Content="Preferir GPU dedicada"/>
                        <CheckBox x:Name="SettingsShowFpsCheck" Content="Mostrar FPS"/>
                        <CheckBox x:Name="SettingsDiagnosticsCheck" Content="Diagnóstico do runtime"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="CompatibilityView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <StackPanel Margin="28"
                            Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE73E;"
                                  FontSize="28"
                                  Foreground="#8DB7FF"/>
                        <TextBlock Text="Compatibilidade"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="CompatibilityMapCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="CompatibilityVehicleCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="CompatibilityObjectCountText" Text="0" Foreground="White"/>
                        <TextBlock x:Name="CompatibilityMissingScriptsText" Text="0" Foreground="White"/>
                    </StackPanel>
                    <TextBlock x:Name="CompatibilityContentRootText" Text="Biblioteca: não configurada" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                    <TextBlock x:Name="CompatibilityRuntimeText" Text="Runtime: verificando" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                    <TextBlock x:Name="CompatibilityOdeText" Text="ODE: verificando" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                    <TextBlock x:Name="CompatibilityRendererText" Text="D3D11: verificando" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                    <TextBlock x:Name="CompatibilityModelText" Text="model.cfg: aguardando" TextWrapping="Wrap" Foreground="#AFC0D2"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="DiagnosticsView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="#0A1420">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE9D9;"
                                  FontSize="28"
                                  Foreground="#8DB7FF"/>
                        <TextBlock Text="Diagnóstico"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,10" Spacing="5">
                        <TextBlock x:Name="DiagnosticsRuntimeText" Text="Runtime" Foreground="#AFC0D2"/>
                        <TextBlock x:Name="DiagnosticsContentText" Text="Conteúdo" Foreground="#AFC0D2"/>
                        <TextBlock x:Name="DiagnosticsReportPathText" Text="" TextWrapping="Wrap" Foreground="#7F94AA"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copiar" Click="CopyDiagnosticsButton_Click"/>
                            <Button Content="Gerar relatório" Click="GenerateDiagnosticsReportButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="DiagnosticsTextBox"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Background="#091522"
              Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatusTitle" Text="Launcher" Foreground="White"/>
                <TextBlock x:Name="FooterStatusDetail" Text="Pronto." Foreground="#93A4B7"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Text="Mapas" Foreground="#8194AA"/>
                <TextBlock x:Name="FooterMapCountText" Text="0" Foreground="White"/>
                <TextBlock Text="Veículos" Foreground="#8194AA"/>
                <TextBlock x:Name="FooterBusCountText" Text="0" Foreground="White"/>
                <TextBlock Text="Objetos" Foreground="#8194AA"/>
                <TextBlock x:Name="FooterObjectCountText" Text="0" Foreground="White"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="LogBox"
                 Visibility="Collapsed"/>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#E008111C">
            <Border Width="620"
                    Padding="24"
                    Background="#111E2D"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <Image x:Name="LoadingImage"
                           Height="180"
                           Stretch="UniformToFill"/>
                    <TextBlock x:Name="LoadingMapText" Text="Mapa" Foreground="White" FontSize="20"/>
                    <TextBlock x:Name="LoadingBusText" Text="Ônibus" Foreground="#AFC0D2"/>
                    <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="100"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LoadingStageText" Text="Inicializando" Foreground="#AFC0D2"/>
                        <TextBlock x:Name="LoadingPercentText" Grid.Column="1" Text="0%" Foreground="White"/>
                    </Grid>
                    <TextBlock x:Name="LoadingDetailText" Text="" TextWrapping="Wrap" Foreground="#8194AA"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
