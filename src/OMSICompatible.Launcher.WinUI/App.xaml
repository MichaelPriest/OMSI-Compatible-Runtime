<Application
    x:Class="OMSICompatible.Launcher.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="UiSurfaceBrush" Color="#111E2D"/>
                    <SolidColorBrush x:Key="UiSurfaceHoverBrush" Color="#1B3045"/>
                    <SolidColorBrush x:Key="UiAccentBrush" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="UiTextBrush" Color="#EAF2FA"/>
                    <SolidColorBrush x:Key="UiMutedBrush" Color="#91A5BA"/>
            
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#192A3D"/>
                        <Setter Property="Foreground" Value="#EAF2FA"/>
                        <Setter Property="BorderBrush" Value="#30465C"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="14,9"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="MinHeight" Value="38"/>
                    </Style>
            
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#101D2B"/>
                        <Setter Property="Foreground" Value="#F1F5F9"/>
                        <Setter Property="BorderBrush" Value="#34495E"/>
                        <Setter Property="SelectionHighlightColor" Value="#0E7490"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="Padding" Value="10,7"/>
                    </Style>
            
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="#101D2B"/>
                        <Setter Property="Foreground" Value="#F1F5F9"/>
                        <Setter Property="BorderBrush" Value="#34495E"/>
                        <Setter Property="CornerRadius" Value="5"/>
                        <Setter Property="MinHeight" Value="36"/>
                    </Style>
            
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="#D6E2EF"/>
                        <Setter Property="MinHeight" Value="30"/>
                    </Style>
            
                    <Style TargetType="TabView">
                        <Setter Property="Background" Value="#0A1420"/>
                        <Setter Property="Foreground" Value="#EAF2FA"/>
                    </Style>

            <SolidColorBrush x:Key="CardBrush" Color="#171C24"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#93A2B6"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#178BDB"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
