<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OMSICompatible.Launcher.Legacy</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OmsiCompat.Core/OmsiCompat.Core.csproj" />
    <ProjectReference Include="../OmsiCompat.Map/OmsiCompat.Map.csproj" />
    <ProjectReference Include="../OmsiCompat.Vehicles/OmsiCompat.Vehicles.csproj" />
    <ProjectReference Include="../OMSICompatible.Renderer.D3D11/OMSICompatible.Renderer.D3D11.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../OMSICompatible.Renderer.D3D11/Shaders/*.hlsl"
             Link="Shaders/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
